# Neon PostgreSQL connection
DATABASE_URL=jdbc:postgresql://<neon-host>/<db-name>?sslmode=require
DATABASE_USERNAME=<neon-username>
DATABASE_PASSWORD=<neon-password>

# JWT
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=86400000

# CORS - the deployed Vercel frontend URL
FRONTEND_URL=https://your-project.vercel.app

# AI chatbot (optional - the chatbot still works from the database without it)
AI_API_KEY=
AI_API_URL=https://api.anthropic.com/v1/messages
AI_MODEL=claude-sonnet-4-5

# Optional: auto-create an admin account on first startup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-strong-password

# Server
PORT=8080
SPRING_PROFILES_ACTIVE=prod
